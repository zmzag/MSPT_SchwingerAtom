    RowBox[{
     RowBox[{"potentialhamiltonian", "[", "x_", "]"}], ":=", 
     RowBox[{
      RowBox[{"2", "*", "Pi", "*", "\[Kappa]", "*", 
       RowBox[{"cosTerm", "[", "x", "]"}]}], "+", 
