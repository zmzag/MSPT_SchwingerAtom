   RowBox[{
    RowBox[{"PhiVSYKappa0p2G1p5", "=", 
     RowBox[{"Interpolation", "[", 
      RowBox[{"FinalPhiList", ",", 
       RowBox[{"InterpolationOrder", "->", "4"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Phi]ss", "[", "x_", "]"}], ":=", 
     RowBox[{"PhiVSYKappa0p2G1p5", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"\[Pi]", "^", 
          RowBox[{"(", 
           RowBox[{"1", "/", "2"}], ")"}]}], "*", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"2", " ", "\[Pi]", "*", "\[Kappa]"}], ")"}], "^", 
            RowBox[{"(", 
             RowBox[{"1", "/", "2"}], ")"}]}], " ", "x"}], "]"}]}], ")"}], 
       "/", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"2", " ", "\[Pi]", "*", "\[Kappa]"}], ")"}], "^", 
            RowBox[{"(", 
             RowBox[{"1", "/", "2"}], ")"}]}], " ", "x"}], "]"}]}], ")"}]}], 
      "]"}]}], ";", 
    RowBox[{"data", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"\[Phi]ss", "[", "x", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"-", "150"}], ",", "150", ",", "0.001"}], "}"}]}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"\[Phi]ssint", "=", 
     RowBox[{"Interpolation", "[", "data", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"intermediatePhi", "[", "x_", "]"}], ":=", 
     RowBox[{"2", "*", 
      RowBox[{"Sqrt", "[", "\[Pi]", "]"}], "*", 
      RowBox[{"\[Phi]ssint", "[", "x", "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"cosTerm", "[", "x_", "]"}], ":=", 
     RowBox[{"Cos", "[", 
      RowBox[{"intermediatePhi", "[", "x", "]"}], "]"}]}], ";"}], "\n", 
