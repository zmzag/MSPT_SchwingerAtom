               RowBox[{"[", 
                RowBox[{"n", ",", "j"}], "]"}], "]"}]}], "-", 
             RowBox[{"Bcoeff", "*", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"Conjugate", "[", 
                  RowBox[{
                   RowBox[{"varsA", "[", 
                    RowBox[{"[", 
                    RowBox[{"n", ",", "i"}], "]"}], "]"}], "[", "t", "]"}], 
