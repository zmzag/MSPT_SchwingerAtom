       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"varsA", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "j"}], "]"}], "]"}], "'"}], "[", "t", "]"}], "==", 
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Acoeff", "*", 
              RowBox[{"Conjugate", "[", 
               RowBox[{
                RowBox[{"varsA", "[", 
                 RowBox[{"[", 
                  RowBox[{"n", ",", "i"}], "]"}], "]"}], "[", "t", "]"}], 
               "]"}], "*", 
