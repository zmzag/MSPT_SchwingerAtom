                   RowBox[{"varsA", "[", 
                    RowBox[{"[", 
                    RowBox[{"j", ",", "n"}], "]"}], "]"}], "[", "t", "]"}], 
                  "]"}]}]}], ")"}]}], "+", 
             RowBox[{"Ccoeff", "*", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{
