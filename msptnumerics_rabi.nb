Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "EOMs", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"eqs", "=", 
    RowBox[{"Flatten", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"varsSig", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "j"}], "]"}], "]"}], "'"}], "[", "t", "]"}], "==", 
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"varsA", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "n"}], "]"}], "]"}], "[", "t", "]"}], "*", 
             RowBox[{
              RowBox[{"varsA", "[", 
               RowBox[{"[", 
                RowBox[{"n", ",", "j"}], "]"}], "]"}], "[", "t", "]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"n", ",", "nStates"}], "}"}]}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "nStates"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "nStates"}], "}"}]}], "]"}], ",", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"varsA", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "j"}], "]"}], "]"}], "'"}], "[", "t", "]"}], "==", 
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Acoeff", "*", 
              RowBox[{"Conjugate", "[", 
               RowBox[{
                RowBox[{"varsA", "[", 
                 RowBox[{"[", 
                  RowBox[{"n", ",", "i"}], "]"}], "]"}], "[", "t", "]"}], 
               "]"}], "*", 
              RowBox[{"matAk2b", "[", 
               RowBox[{"[", 
                RowBox[{"n", ",", "j"}], "]"}], "]"}]}], "-", 
             RowBox[{"Bcoeff", "*", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"Conjugate", "[", 
                  RowBox[{
                   RowBox[{"varsA", "[", 
                    RowBox[{"[", 
                    RowBox[{"n", ",", "i"}], "]"}], "]"}], "[", "t", "]"}], 
