            RowBox[{"(", 
             RowBox[{"1", "/", "2"}], ")"}]}], " ", "x"}], "]"}]}], ")"}]}], 
      "]"}]}], ";", 
    RowBox[{"data", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"\[Phi]ss", "[", "x", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"-", "150"}], ",", "150", ",", "0.001"}], "}"}]}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"\[Phi]ssint", "=", 
     RowBox[{"Interpolation", "[", "data", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"intermediatePhi", "[", "x_", "]"}], ":=", 
     RowBox[{"2", "*", 
      RowBox[{"Sqrt", "[", "\[Pi]", "]"}], "*", 
      RowBox[{"\[Phi]ssint", "[", "x", "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"cosTerm", "[", "x_", "]"}], ":=", 
