                    RowBox[{"n", ",", "j"}], "]"}], "]"}], "[", "t", "]"}]}], 
                "+", 
                RowBox[{
                 RowBox[{
                  RowBox[{"varsSig", "[", 
                   RowBox[{"[", 
                    RowBox[{"i", ",", "n"}], "]"}], "]"}], "[", "t", "]"}], 
