         RowBox[{
          RowBox[{"-", ".25"}], ",", "1.5"}], "}"}]}], "}"}]}], ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<x\>\"", ",", "\"\<\[Delta]k(x)\>\""}], "}"}]}], ",", 
