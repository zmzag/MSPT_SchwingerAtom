Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Plotting", " ", "Lamb", " ", "shift", " ", "due", " ", "to", " ", "k2b", 
    " ", "occupation"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"k", "=", "88"}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "Put", " ", "whatever", " ", "k", " ", "corresponds", " ", "to", " ", 
      "the", " ", "k2b", " ", "mode", " ", "here"}], ",", " ", "even"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"k2b", "=", 
     RowBox[{"Sqrt", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"2", "*", "\[Omega]b"}], ")"}], "^", "2"}], "-", 
       RowBox[{"g", "^", "2"}], "-", 
       RowBox[{"2", "*", "Pi", "*", "\[Kappa]"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Phi]k", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "/", 
        RowBox[{"Sqrt", "[", "2", "]"}]}], ")"}], "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"fns", "[", 
         RowBox[{"[", 
          RowBox[{"k", "+", "1"}], "]"}], "]"}], "+", 
        RowBox[{"I", "*", 
         RowBox[{"fns", "[", 
          RowBox[{"[", "k", "]"}], "]"}]}]}], ")"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Vbbkstark", "=", 
     RowBox[{"NIntegrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"cosTerm", "[", "x", "]"}], "*", 
        RowBox[{
         RowBox[{"fns", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "^", "2"}], "*", 
        RowBox[{
         RowBox[{"Abs", "[", "\[Phi]k", "]"}], "^", "2"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{
          RowBox[{"-", "L"}], "/", "2"}], ",", 
         RowBox[{"L", "/", "2"}]}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Eshiftk", "[", 
      RowBox[{"n_", ",", "m_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"n", "*", "\[Omega]b"}], "-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"3", "*", "n", "*", "\[Kappa]", "*", 
         RowBox[{"\[Lambda]4", "/", 
          RowBox[{"(", 
           RowBox[{"2", "*", "\[Omega]b"}], ")"}]}]}], ")"}], "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Vbbbb", "*", 
          RowBox[{"n", "/", 
           RowBox[{"(", 
            RowBox[{"2", "*", "\[Omega]b"}], ")"}]}]}], "+", 
         RowBox[{"Vbbkstark", "*", 
          RowBox[{"m", "/", "k2b"}]}]}], ")"}]}]}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"n", " ", "is", " ", "bound", " ", "occupation"}], ",", " ", 
     RowBox[{"m", " ", "is", " ", "k", " ", "occupation"}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Eshiftk", "[", 
        RowBox[{"1", ",", "5"}], "]"}], ",", 
       RowBox[{"Eshiftk", "[", 
        RowBox[{"1", ",", "4"}], "]"}], ",", 
       RowBox[{"Eshiftk", "[", 
        RowBox[{"1", ",", "3"}], "]"}], ",", 
       RowBox[{"Eshiftk", "[", 
        RowBox[{"1", ",", "2"}], "]"}], ",", 
       RowBox[{"Eshiftk", "[", 
        RowBox[{"1", ",", "1"}], "]"}], ",", 
       RowBox[{"Eshiftk", "[", 
        RowBox[{"1", ",", "0"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "5"}], "}"}], ",", 
     RowBox[{"PlotLabels", "->", 
      RowBox[{"{", 
       RowBox[{
       "\"\<nb=1,nk=5\>\"", ",", "\"\<nb=1,nk=4\>\"", ",", 
        "\"\<nb=1,nk=3\>\"", ",", "\"\<nb=1,nk=2\>\"", ",", 
        "\"\<nb=1,nk=1\>\"", ",", "\"\<nb=1,nk=0\>\""}], "}"}]}], ",", 
     RowBox[{"PlotRange", "->", "All"}]}], "]"}]}]}]], "Input",
