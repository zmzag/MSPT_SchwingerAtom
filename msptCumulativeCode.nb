Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "Vkkstarppstar", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"listsize", "=", "49"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Vkkpplist", "=", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0", ",", 
       RowBox[{"{", 
        RowBox[{"listsize", ",", "listsize"}], "}"}]}], "]"}]}], ";"}], "\n", 
   
   RowBox[{
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"i", "=", "2"}], ",", 
      RowBox[{"i", "<=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"listsize", "-", "1"}], ")"}], "*", "2"}]}], ",", 
      RowBox[{"i", "=", 
       RowBox[{"i", "+", "2"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[Phi]i", "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "/", 
           RowBox[{"Sqrt", "[", "2", "]"}]}], ")"}], "*", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"fns", "[", 
            RowBox[{"[", 
             RowBox[{"i", "+", "1"}], "]"}], "]"}], "+", 
           RowBox[{"I", "*", 
            RowBox[{"fns", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}]}], ")"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"j", "=", "2"}], ",", 
         RowBox[{"j", "<=", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"listsize", "-", "1"}], ")"}], "*", "2"}]}], ",", 
         RowBox[{"j", "=", 
          RowBox[{"j", "+", "2"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"\[Phi]j", "=", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", "/", 
              RowBox[{"Sqrt", "[", "2", "]"}]}], ")"}], "*", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"fns", "[", 
               RowBox[{"[", 
                RowBox[{"j", "+", "1"}], "]"}], "]"}], "+", 
              RowBox[{"I", "*", 
               RowBox[{"fns", "[", 
                RowBox[{"[", "j", "]"}], "]"}]}]}], ")"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"index1", "=", 
           RowBox[{"i", "/", "2"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"index2", "=", 
           RowBox[{"j", "/", "2"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Vkkpplist", "[", 
            RowBox[{"[", 
             RowBox[{"index1", ",", "index2"}], "]"}], "]"}], "=", 
           RowBox[{"NIntegrate", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Cos", "[", 
               RowBox[{"2", "*", 
                RowBox[{"Sqrt", "[", "Pi", "]"}], "*", 
                RowBox[{"\[Phi]ssint", "[", "x", "]"}]}], "]"}], "*", 
              RowBox[{
               RowBox[{"Abs", "[", "\[Phi]i", "]"}], "^", "2"}], "*", 
              RowBox[{
               RowBox[{"Abs", "[", "\[Phi]j", "]"}], "^", "2"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"x", ",", 
               RowBox[{
                RowBox[{"-", "L"}], "/", "2"}], ",", 
               RowBox[{"L", "/", "2"}]}], "}"}]}], "]"}]}], ";"}]}], "]"}], 
       ";"}]}], "]"}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.988212482569606*^9, 3.988212623643478*^9}, {
  3.988277135254743*^9, 3.988277175147575*^9}, {3.988279252153612*^9, 
  3.988279258470652*^9}},
 CellLabel->
  "In[131]:=",ExpressionUUID->"9e2f3eb2-319a-4a19-b671-abdcd5ac38c9"],

