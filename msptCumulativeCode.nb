Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Generating", " ", "eigenfunctions"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"H1", "=", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{
        RowBox[{"u", "''"}], "[", "x", "]"}]}], "+", 
      RowBox[{
       RowBox[{"Evaluate", "[", 
        RowBox[{"potentialhamiltonian", "[", "x", "]"}], "]"}], "*", 
       RowBox[{"u", "[", "x", "]"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"vals", ",", "fns"}], "}"}], "=", 
     RowBox[{"NDEigensystem", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"H1", ",", 
         RowBox[{"DirichletCondition", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"u", "[", "x", "]"}], "==", "0"}], ",", "True"}], "]"}]}],
         "}"}], ",", 
       RowBox[{"u", "[", "x", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{
          RowBox[{"-", "L"}], "/", "2"}], ",", 
         RowBox[{"L", "/", "2"}]}], "}"}], ",", "total", ",", 
       RowBox[{"Method", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\"\<PDEDiscretization\>\"", "->", 
           RowBox[{"{", 
            RowBox[{"\"\<FiniteElement\>\"", ",", 
             RowBox[{"\"\<MeshOptions\>\"", "->", 
              RowBox[{"{", 
               RowBox[{"\"\<MaxCellMeasure\>\"", "->", "dx"}], "}"}]}]}], 
            "}"}]}], ",", "\"\<Arnoldi\>\"", ",", 
          RowBox[{"\"\<MaxIterations\>\"", "->", "7000"}], ",", 
          RowBox[{"\"\<BasisSize\>\"", "->", 
           RowBox[{"total", "+", "1"}]}], ",", 
          RowBox[{"\"\<Shift\>\"", "->", "2.8"}]}], "}"}]}]}], "]"}]}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{3.987071505881794*^9, 3.987071511954973*^9}, {
  3.987071578956678*^9, 3.987071601521065*^9}},
 CellLabel->"In[14]:=",ExpressionUUID->"81f9f21c-9d86-473d-a48b-06708d72e672"],

