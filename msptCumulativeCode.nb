Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Showing", " ", "integrand", " ", "decays"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"klist", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"integrandlist", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"k", "=", "3"}], ",", 
      RowBox[{"k", "<=", "total"}], ",", 
      RowBox[{"k", "=", 
       RowBox[{"k", "+", "2"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"integrand", "=", "0"}], ";", "\[IndentingNewLine]", 
       RowBox[{"\[Phi]k", "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "/", 
           RowBox[{"Sqrt", "[", "2", "]"}]}], ")"}], "*", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"fns", "[", 
            RowBox[{"[", 
             RowBox[{"k", "+", "1"}], "]"}], "]"}], "+", 
           RowBox[{"I", "*", 
            RowBox[{"fns", "[", 
             RowBox[{"[", "k", "]"}], "]"}]}]}], ")"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"\[Omega]k", "=", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"vals", "[", 
          RowBox[{"[", "k", "]"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Vbbkstark", "=", 
        RowBox[{"NIntegrate", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"cosTerm", "[", "x", "]"}], "*", 
           RowBox[{
            RowBox[{"fns", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "^", "2"}], "*", 
           RowBox[{
            RowBox[{"Abs", "[", "\[Phi]k", "]"}], "^", "2"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", 
            RowBox[{
             RowBox[{"-", "L"}], "/", "2"}], ",", 
            RowBox[{"L", "/", "2"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"ktilde", "=", 
        RowBox[{"Sqrt", "[", 
         RowBox[{
          RowBox[{"\[Omega]k", "^", "2"}], "-", 
          RowBox[{"2", "*", "Pi", "*", "\[Kappa]"}], "-", 
          RowBox[{"g", "^", "2"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"coeff", "=", 
        RowBox[{"3", "*", 
         RowBox[{"\[Lambda]4", "/", 
          RowBox[{"(", 
           RowBox[{"ktilde", "*", "2", "*", "\[Omega]b", "*", "L"}], 
           ")"}]}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"integrand", "=", 
        RowBox[{"coeff", "*", "Vbbkstark"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"AppendTo", "[", 
