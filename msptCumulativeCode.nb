    RowBox[{
     RowBox[{"fns", "[", 
      RowBox[{"[", "1", "]"}], "]"}], "^", "2"}], "*", 
    RowBox[{
     RowBox[{"Abs", "[", "\[Phi]k", "]"}], "^", "2"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{
      RowBox[{"-", "L"}], "/", "2"}], ",", 
     RowBox[{"L", "/", "2"}]}], "}"}]}], "]"}], "\[IndentingNewLine]", 
