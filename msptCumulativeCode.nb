        "\"\<k=3\>\"", ",", "\"\<k=2\>\""}], "}"}]}]}], "]"}], "\n", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"Evaluate", "[", 
      RowBox[{"fns", "[", 
       RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", 
