         RowBox[{"fns", "[", 
          RowBox[{"[", "9", "]"}], "]"}], "+", "1.28"}], "]"}], ",", 
       RowBox[{"Evaluate", "[", 
        RowBox[{
         RowBox[{"fns", "[", 
