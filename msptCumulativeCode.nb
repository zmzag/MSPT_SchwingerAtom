Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Showing", " ", "\[Beta]b"}], " ", "->", " ", "0"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"efuns", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"i", "=", "1"}], ",", 
      RowBox[{"i", "<=", "total"}], ",", 
      RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[Psi]", "=", 
        RowBox[{"fns", "[", 
         RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"xRange", "=", 
        RowBox[{"Range", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "L"}], "/", "2"}], ",", 
          RowBox[{"L", "/", "2"}], ",", "0.01"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"originalData", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"x", ",", 
            RowBox[{"\[Psi]", "/.", " ", 
             RowBox[{"x", "->", "x"}]}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", "xRange"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"originalInterp", "=", 
        RowBox[{"Interpolation", "[", "originalData", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"AppendTo", "[", 
        RowBox[{"efuns", ",", "originalInterp"}], "]"}], ";"}]}], 
     "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Phi]b", "[", "x_", "]"}], ":=", 
     RowBox[{
      RowBox[{"efuns", "[", 
       RowBox[{"[", "1", "]"}], "]"}], "[", "x", "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"d\[Phi]b", "[", "x_", "]"}], ":=", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"\[Phi]b", "[", "X", "]"}], ",", "X"}], "]"}], "/.", 
      RowBox[{"X", "->", "x"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"kb", "[", "x_", "]"}], ":=", 
     RowBox[{
      RowBox[{"-", "I"}], "*", 
      RowBox[{
       RowBox[{"d\[Phi]b", "[", "x", "]"}], "/", 
       RowBox[{"\[Phi]b", "[", "x", "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Beta]b", "=", 
     RowBox[{
      RowBox[{"-", "I"}], "*", 
      RowBox[{"NIntegrate", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"kb", "[", "x", "]"}], "*", 
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{"\[Phi]b", "[", "x", "]"}], "]"}], "^", "2"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", 
          RowBox[{
           RowBox[{"-", "L"}], "/", "2"}], ",", 
          RowBox[{"L", "/", "2"}]}], "}"}]}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"\[Phi]b", "[", "x", "]"}], "]"}], "^", "2"}], ",", 
       RowBox[{"Im", "[", 
        RowBox[{"kb", "[", "x", "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"-", "5"}], ",", "5"}], "}"}], ",", 
     RowBox[{"PlotLegends", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<|\[Phi]b|^2\>\"", ",", "\"\<Im[kb]\>\""}], "}"}]}]}], 
    "]"}], "\[IndentingNewLine]", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<\[Beta]b = \>\"", ",", "\[Beta]b"}], "]"}]}]}]], "Input",
