   RowBox[{
    RowBox[{
     RowBox[{"Eshift", "[", "n_", "]"}], ":=", 
     RowBox[{
      RowBox[{"n", "*", "\[Omega]b"}], "-", 
      RowBox[{
       RowBox[{"n", "^", "2"}], "*", "nshift"}]}]}], ";"}], 
