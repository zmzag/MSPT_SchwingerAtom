Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"listsize", "=", "50"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Vb2bkplist", "=", 
   RowBox[{"ConstantArray", "[", 
    RowBox[{"0", ",", 
     RowBox[{"{", 
      RowBox[{"listsize", ",", "listsize"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"For", "[", 
   RowBox[{
    RowBox[{"i", "=", "0"}], ",", 
    RowBox[{"i", "<=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"listsize", "-", "1"}], ")"}], "*", "2"}]}], ",", 
    RowBox[{"i", "=", 
     RowBox[{"i", "+", "2"}]}], ",", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"i", "==", "0"}], ",", 
       RowBox[{"\[Phi]i", "=", 
        RowBox[{"fns", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ",", 
       RowBox[{"\[Phi]i", "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "/", 
           RowBox[{"Sqrt", "[", "2", "]"}]}], ")"}], "*", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"fns", "[", 
            RowBox[{"[", 
             RowBox[{"i", "+", "1"}], "]"}], "]"}], "+", 
           RowBox[{"I", "*", 
            RowBox[{"fns", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}]}], ")"}]}]}]}], "]"}], ";", 
