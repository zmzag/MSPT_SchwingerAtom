Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "Vbbkp", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"listsize", "=", "50"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Vbbkplist", "=", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0", ",", 
       RowBox[{"{", 
        RowBox[{"listsize", ",", "listsize"}], "}"}]}], "]"}]}], ";"}], "\n", 
   
   RowBox[{
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"i", "=", "0"}], ",", 
      RowBox[{"i", "<=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"listsize", "-", "1"}], ")"}], "*", "2"}]}], ",", 
      RowBox[{"i", "=", 
       RowBox[{"i", "+", "2"}]}], ",", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"i", "==", "0"}], ",", 
         RowBox[{"\[Phi]i", "=", 
          RowBox[{"fns", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ",", 
         RowBox[{"\[Phi]i", "=", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "/", 
             RowBox[{"Sqrt", "[", "2", "]"}]}], ")"}], "*", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"fns", "[", 
              RowBox[{"[", 
               RowBox[{"i", "+", "1"}], "]"}], "]"}], "+", 
             RowBox[{"I", "*", 
              RowBox[{"fns", "[", 
               RowBox[{"[", "i", "]"}], "]"}]}]}], ")"}]}]}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"j", "=", "0"}], ",", 
         RowBox[{"j", "<=", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"listsize", "-", "1"}], ")"}], "*", "2"}]}], ",", 
         RowBox[{"j", "=", 
          RowBox[{"j", "+", "2"}]}], ",", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"j", "==", "0"}], ",", 
            RowBox[{"\[Phi]j", "=", 
             RowBox[{"fns", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], ",", 
            RowBox[{"\[Phi]j", "=", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"1", "/", 
                RowBox[{"Sqrt", "[", "2", "]"}]}], ")"}], "*", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"fns", "[", 
                 RowBox[{"[", 
                  RowBox[{"j", "+", "1"}], "]"}], "]"}], "+", 
                RowBox[{"I", "*", 
                 RowBox[{"fns", "[", 
                  RowBox[{"[", "j", "]"}], "]"}]}]}], ")"}]}]}]}], "]"}], ";",
           "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"i", "==", "0"}], ",", 
            RowBox[{"index1", "=", "1"}], ",", 
            RowBox[{"index1", "=", 
             RowBox[{
              RowBox[{"i", "/", "2"}], "+", "1"}]}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"j", "==", "0"}], ",", 
            RowBox[{"index2", "=", "1"}], ",", 
            RowBox[{"index2", "=", 
             RowBox[{
              RowBox[{"j", "/", "2"}], "+", "1"}]}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Vbbkplist", "[", 
            RowBox[{"[", 
             RowBox[{"index1", ",", "index2"}], "]"}], "]"}], "=", 
           RowBox[{"NIntegrate", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Cos", "[", 
               RowBox[{"2", "*", 
                RowBox[{"Sqrt", "[", "Pi", "]"}], "*", 
                RowBox[{"\[Phi]ssint", "[", "x", "]"}]}], "]"}], "*", 
              RowBox[{"fns", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "*", 
              RowBox[{"fns", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "*", "\[Phi]i", "*", 
              "\[Phi]j"}], ",", 
             RowBox[{"{", 
              RowBox[{"x", ",", 
               RowBox[{
                RowBox[{"-", "L"}], "/", "2"}], ",", 
               RowBox[{"L", "/", "2"}]}], "}"}]}], "]"}]}], ";"}]}], "]"}], 
       ";"}]}], "]"}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.988212254675249*^9, 3.988212281191677*^9}},
 CellLabel->
  "In[115]:=",ExpressionUUID->"c729310c-6122-4358-a214-a59fabb33b89"],

