 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Plotting", " ", "eigenfunctions"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
