Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Rabi", " ", "Oscillations"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"k", "=", "89"}], ";"}], 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "Put", " ", "whatever", " ", "k", " ", "corresponds", " ", "to", " ", 
      "the", " ", "k2b", " ", "mode"}], ",", " ", "even"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Lambda]3", "=", 
     RowBox[{"2", "*", 
      RowBox[{"Pi", "^", 
       RowBox[{"(", 
        RowBox[{"3", "/", "2"}], ")"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"k2b", "=", 
     RowBox[{"Sqrt", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"2", "*", "\[Omega]b"}], ")"}], "^", "2"}], "-", 
       RowBox[{"g", "^", "2"}], "-", 
       RowBox[{"2", "*", "Pi", "*", "\[Kappa]"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"fk", "[", "x_", "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"fns", "[", 
         RowBox[{"[", 
          RowBox[{"k", "+", "1"}], "]"}], "]"}], "+", 
        RowBox[{"I", "*", 
         RowBox[{"fns", "[", 
          RowBox[{"[", "k", "]"}], "]"}]}]}], ")"}], "/", 
      RowBox[{"Sqrt", "[", "2", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Vbbk", "=", 
     RowBox[{"NIntegrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Sin", "[", 
         RowBox[{"intermediatePhi", "[", "x", "]"}], "]"}], "*", 
        RowBox[{"fns", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "*", 
        RowBox[{"fns", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "*", 
        RowBox[{"fk", "[", "x", "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{
          RowBox[{"-", "L"}], "/", "2"}], ",", 
         RowBox[{"L", "/", "2"}]}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Bparam", "=", 
     RowBox[{
      RowBox[{"\[Lambda]3", "^", "2"}], "*", 
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", "Vbbk", "]"}], "^", "2"}], "/", 
       RowBox[{"(", 
        RowBox[{"4", "*", 
         RowBox[{"\[Omega]b", "^", "3"}]}], ")"}]}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Cparam", "=", 
    RowBox[{"3", "*", "I", "*", "\[Lambda]4", "*", 
     RowBox[{"Vbbbb", "/", 
      RowBox[{"(", 
       RowBox[{"4", "*", 
        RowBox[{"\[Omega]b", "^", "2"}]}], ")"}]}]}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tMax", "=", "100"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sol", "=", 
     RowBox[{"NDSolve", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"nb", "'"}], "[", "t", "]"}], "==", 
          RowBox[{
           RowBox[{"-", "2"}], "*", "Bparam", "*", 
           RowBox[{"Re", "[", 
            RowBox[{"s", "[", "t", "]"}], "]"}]}]}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"s", "'"}], "[", "t", "]"}], "==", 
          RowBox[{
           RowBox[{"q", "[", "t", "]"}], "-", 
           RowBox[{"Bparam", "*", 
            RowBox[{"p", "[", "t", "]"}]}], "+", 
           RowBox[{"Cparam", "*", 
            RowBox[{"s", "[", "t", "]"}]}]}]}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"q", "'"}], "[", "t", "]"}], "==", 
          RowBox[{
           RowBox[{"-", "2"}], "*", "Bparam", "*", 
           RowBox[{"Re", "[", 
            RowBox[{"s", "[", "t", "]"}], "]"}]}]}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"p", "'"}], "[", "t", "]"}], "==", 
          RowBox[{"2", "*", 
           RowBox[{"Re", "[", 
            RowBox[{"s", "[", "t", "]"}], "]"}]}]}], ",", 
         RowBox[{
          RowBox[{"nb", "[", "0", "]"}], "==", "2"}], ",", 
         RowBox[{
          RowBox[{"s", "[", "0", "]"}], "==", 
          RowBox[{"0", "+", 
           RowBox[{"0", "*", "I"}]}]}], ",", 
         RowBox[{
          RowBox[{"q", "[", "0", "]"}], "==", "2"}], ",", 
         RowBox[{
          RowBox[{"p", "[", "0", "]"}], "==", "0"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"nb", ",", "s", ",", "q", ",", "p"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", "tMax"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"nb", "[", "t", "]"}], "/.", "sol"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "tMax"}], "}"}], ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Style", "[", 
         RowBox[{"\"\<\[Tau]\>\"", ",", "14"}], "]"}], ",", 
        RowBox[{"Style", "[", 
         RowBox[{"\"\<<n_b>\>\"", ",", "14"}], "]"}]}], "}"}]}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"Directive", "[", 
       RowBox[{
        RowBox[{"Darker", "@", "Green"}], ",", "Thick"}], "]"}]}]}], 
    "]"}]}]}]], "Input",
 CellChangeTimes->{{3.987078938379648*^9, 3.987079210549278*^9}, {
