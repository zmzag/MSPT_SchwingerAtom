Notebook[{
Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "Coefficients", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"g", "=", "1.5"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Kappa]", "=", "0.2"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Domain", " ", "and", " ", "spacing", " ", "for", " ", "calculating", " ",
      "eigenfunctions"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"L", "=", "100"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"dx", "=", "0.01"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "total", " ", "number", " ", "of", " ", "eigenfunctions", " ", "to", " ", 
      RowBox[{"calculate", ".", "  ", "To"}], " ", "calculate", " ", "the", 
      " ", "results", " ", "in", " ", "this", " ", "paper", " ", "you", " ", 
      "need", " ", "at", " ", "least", " ", "enough", " ", "such", " ", 
      "that", " ", "there", " ", "exists", " ", "an", " ", "\[Omega]k"}], "=", 
     RowBox[{"2", "*", "\[Omega]b"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"total", "=", "200"}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.987071138574553*^9, 3.987071161531517*^9}, {
  3.987071229455191*^9, 3.98707124052133*^9}, {3.987071303277001*^9, 
  3.9870714297165003`*^9}, {3.987154713403686*^9, 3.987154713564492*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"a211c3e9-b47b-4df2-93bb-227961bb785c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Loading", " ", "in", " ", "steady", " ", "state", " ", "soliton"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
    "Get", "[", 
     "\"\</scratch/network/zz3250/Wolfram \
Mathematica/SG_SS_Kappa0p2G1p5_N50000\>\"", "]"}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"put", " ", "your", " ", "own", " ", "path", " ", "here"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"Note", " ", "that", " ", "steady"}], "-", 
      RowBox[{
      "state", " ", "soliton", " ", "depends", " ", "on", " ", "g"}]}], ",", 
     "\[Kappa]"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"PhiVSYKappa0p2G1p5", "=", 
     RowBox[{"Interpolation", "[", 
      RowBox[{"FinalPhiList", ",", 
       RowBox[{"InterpolationOrder", "->", "4"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Phi]ss", "[", "x_", "]"}], ":=", 
     RowBox[{"PhiVSYKappa0p2G1p5", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"\[Pi]", "^", 
          RowBox[{"(", 
           RowBox[{"1", "/", "2"}], ")"}]}], "*", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"2", " ", "\[Pi]", "*", "\[Kappa]"}], ")"}], "^", 
            RowBox[{"(", 
             RowBox[{"1", "/", "2"}], ")"}]}], " ", "x"}], "]"}]}], ")"}], 
       "/", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"2", " ", "\[Pi]", "*", "\[Kappa]"}], ")"}], "^", 
            RowBox[{"(", 
             RowBox[{"1", "/", "2"}], ")"}]}], " ", "x"}], "]"}]}], ")"}]}], 
      "]"}]}], ";", 
    RowBox[{"data", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"\[Phi]ss", "[", "x", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"-", "150"}], ",", "150", ",", "0.001"}], "}"}]}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"\[Phi]ssint", "=", 
     RowBox[{"Interpolation", "[", "data", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"intermediatePhi", "[", "x_", "]"}], ":=", 
     RowBox[{"2", "*", 
      RowBox[{"Sqrt", "[", "\[Pi]", "]"}], "*", 
      RowBox[{"\[Phi]ssint", "[", "x", "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"cosTerm", "[", "x_", "]"}], ":=", 
     RowBox[{"Cos", "[", 
      RowBox[{"intermediatePhi", "[", "x", "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"potentialhamiltonian", "[", "x_", "]"}], ":=", 
     RowBox[{
      RowBox[{"2", "*", "Pi", "*", "\[Kappa]", "*", 
       RowBox[{"cosTerm", "[", "x", "]"}]}], "+", 
      RowBox[{"g", "^", "2"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"\[Phi]ss", "[", "x", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"-", "5"}], ",", "5"}], "}"}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.987071166202009*^9, 3.987071221458427*^9}, {
  3.987071436468899*^9, 3.987071497024575*^9}},
