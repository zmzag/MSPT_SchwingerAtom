Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Phi]k2b", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "/", 
      RowBox[{"Sqrt", "[", "2", "]"}]}], ")"}], "*", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"fns", "[", 
       RowBox[{"[", 
        RowBox[{"177", "+", "1"}], "]"}], "]"}], "+", 
      RowBox[{"I", "*", 
       RowBox[{"fns", "[", 
        RowBox[{"[", "177", "]"}], "]"}]}]}], ")"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Vbb2b", "=", 
  RowBox[{"NIntegrate", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Sin", "[", 
      RowBox[{"2", "*", 
       RowBox[{"Sqrt", "[", "Pi", "]"}], "*", 
       RowBox[{"\[Phi]ss", "[", "x", "]"}]}], "]"}], "*", "\[Phi]k2b", "*", 
     RowBox[{"fns", "[", 
      RowBox[{"[", "1", "]"}], "]"}], "*", 
     RowBox[{"fns", "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", 
      RowBox[{"-", "100"}], ",", "100"}], "}"}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"\[CapitalGamma]", "=", 
  RowBox[{
   RowBox[{"\[Lambda]3", "/", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Sqrt", "[", "\[Omega]b", "]"}], "*", "k2b"}], ")"}]}], "*", 
   "Vbb2b"}]}]}], "Input",
 CellChangeTimes->{{3.979134883645864*^9, 3.9791349198723516`*^9}, {
