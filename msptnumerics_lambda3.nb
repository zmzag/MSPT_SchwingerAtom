Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{"g", "=", "1.5"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Kappa]", "=", "0.2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Get", "[", 
   "\"\</scratch/network/zz3250/Wolfram Mathematica/SG_SS_Kappa0p2G1p5_N50000\
\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"PhiVSYKappa0p2G1p5", "=", 
   RowBox[{"Interpolation", "[", 
    RowBox[{"FinalPhiList", ",", 
     RowBox[{"InterpolationOrder", "\[Rule]", "4"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Phi]ss", "[", "x_", "]"}], ":=", 
   RowBox[{"PhiVSYKappa0p2G1p5", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"\[Pi]", "^", 
        RowBox[{"(", 
         RowBox[{"1", "/", "2"}], ")"}]}], "*", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"2", " ", "\[Pi]", "*", "\[Kappa]"}], ")"}], "^", 
          RowBox[{"(", 
           RowBox[{"1", "/", "2"}], ")"}]}], " ", "x"}], "]"}]}], ")"}], "/", 
     
     RowBox[{"(", 
      RowBox[{"1", "+", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"2", " ", "\[Pi]", "*", "\[Kappa]"}], ")"}], "^", 
          RowBox[{"(", 
           RowBox[{"1", "/", "2"}], ")"}]}], " ", "x"}], "]"}]}], ")"}]}], 
    "]"}]}], ";", 
  RowBox[{"data", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"\[Phi]ss", "[", "x", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"-", "150"}], ",", "150", ",", "0.001"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Phi]ssint", "=", 
   RowBox[{"Interpolation", "[", "data", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"intermediatePhi", "[", "x_", "]"}], ":=", 
   RowBox[{"2", "*", 
    RowBox[{"Sqrt", "[", "\[Pi]", "]"}], "*", 
    RowBox[{"\[Phi]ssint", "[", "x", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"cosTerm", "[", "x_", "]"}], ":=", 
   RowBox[{"Cos", "[", 
    RowBox[{"intermediatePhi", "[", "x", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"potentialhamiltonian", "[", "x_", "]"}], ":=", 
   RowBox[{
    RowBox[{"2", "*", "Pi", "*", "\[Kappa]", "*", 
     RowBox[{"cosTerm", "[", "x", "]"}]}], " ", "+", 
    RowBox[{"g", "^", "2"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"L", "=", "200"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dx", "=", ".01"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"total", "=", "200"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"H1", "=", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{
      RowBox[{"u", "''"}], "[", "x", "]"}]}], "+", 
    RowBox[{
     RowBox[{"Evaluate", "[", 
      RowBox[{"potentialhamiltonian", "[", "x", "]"}], "]"}], "*", 
     RowBox[{"u", "[", "x", "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"vals", ",", "fns"}], "}"}], "=", 
   RowBox[{"NDEigensystem", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"H1", ",", 
       RowBox[{"DirichletCondition", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"u", "[", "x", "]"}], "==", "0"}], ",", "True"}], "]"}]}], 
      "}"}], ",", 
     RowBox[{"u", "[", "x", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{
        RowBox[{"-", "L"}], "/", "2"}], ",", 
       RowBox[{"L", "/", "2"}]}], "}"}], ",", "total", ",", 
     RowBox[{"Method", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\"\<PDEDiscretization\>\"", "->", 
         RowBox[{"{", 
          RowBox[{"\"\<FiniteElement\>\"", ",", 
           RowBox[{"\"\<MeshOptions\>\"", "->", 
            RowBox[{"{", 
             RowBox[{"\"\<MaxCellMeasure\>\"", "->", "dx"}], "}"}]}]}], 
          "}"}]}], ",", "\"\<Arnoldi\>\"", ",", 
        RowBox[{"\"\<MaxIterations\>\"", "->", "7000"}], ",", 
        RowBox[{"\"\<BasisSize\>\"", "->", 
         RowBox[{"total", "+", "1"}]}], ",", 
        RowBox[{"\"\<Shift\>\"", "->", "2.63"}]}], "}"}]}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "dealing", " ", "with", " ", "mathematica", " ", "being", " ", "weird"}], 
   "*)"}], 
  RowBox[{
   RowBox[{"xRange", "=", 
    RowBox[{"Range", "[", 
     RowBox[{
      RowBox[{"-", "100"}], ",", "100", ",", "dx"}], "]"}]}], ";"}]}], "\n", 
 RowBox[{
  RowBox[{"originalData", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"fns", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], "/.", " ", 
        RowBox[{"x", "->", "x"}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "xRange"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Phi]b", "=", 
   RowBox[{"Interpolation", "[", "originalData", "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{
