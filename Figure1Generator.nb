  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"Import", " ", "Steady"}], "-", 
     RowBox[{"State", " ", "soliton", " ", "for", " ", 
      RowBox[{
       RowBox[{"g", "/"}], "\\", "kappa"}]}]}], "=", "1"}], "*)"}], 
  "\[IndentingNewLine]", 
