   RowBox[{
    RowBox[{"\[Kappa]", "=", "1.5"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"g", "=", "1.5"}], ";"}], "\[IndentingNewLine]", 
