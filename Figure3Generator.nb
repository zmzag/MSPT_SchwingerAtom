Cell[CellGroupData[{
Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{
     "Import", " ", "Steady", " ", "state", " ", "for", " ", "\[Kappa]"}], 
     "=", "0.2"}], ",", 
    RowBox[{"g", "=", "1.5"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Kappa]", "=", "0.2"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"g", "=", "1.5"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Get", "[", 
     "\"\</Users/zoe/Documents/Wolfram Mathematica/fig1_phiss_g1p5_k0p2\>\"", 
     "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Phi0p2", "=", 
     RowBox[{"Interpolation", "[", 
      RowBox[{"FinalPhiList", ",", 
       RowBox[{"InterpolationOrder", "->", "4"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Phi]ss0p2", "[", "x_", "]"}], ":=", 
     RowBox[{"Phi0p2", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"\[Pi]", "^", 
          RowBox[{"(", 
           RowBox[{"1", "/", "2"}], ")"}]}], "*", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"2", "  ", "\[Pi]", "*", "\[Kappa]"}], ")"}], "^", 
            RowBox[{"(", 
             RowBox[{"1", "/", "2"}], ")"}]}], "  ", "x"}], "]"}]}], ")"}], 
       "/", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"2", "  ", "\[Pi]", "*", "\[Kappa]"}], ")"}], "^", 
            RowBox[{"(", 
             RowBox[{"1", "/", "2"}], ")"}]}], "  ", "x"}], "]"}]}], ")"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"data", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"\[Phi]ss0p2", "[", "x", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"-", "50"}], ",", "50", ",", "0.001"}], "}"}]}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"\[Phi]ssint", "=", 
     RowBox[{"Interpolation", "[", "data", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"intermediatePhi", "[", "x_", "]"}], ":=", 
     RowBox[{"2", "*", 
      RowBox[{"Sqrt", "[", "\[Pi]", "]"}], "*", 
      RowBox[{"\[Phi]ssint", "[", "x", "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"cosTerm", "[", "x_", "]"}], ":=", 
     RowBox[{"Cos", "[", 
      RowBox[{"intermediatePhi", "[", "x", "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"potentialhamiltonian", "[", "x_", "]"}], ":=", 
     RowBox[{
      RowBox[{"2", "*", "Pi", "*", "\[Kappa]", "*", 
       RowBox[{"cosTerm", "[", "x", "]"}]}], "+", 
      RowBox[{"g", "^", "2"}]}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.98949009808185*^9, 3.989490129505735*^9}},
