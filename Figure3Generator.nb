Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Finding", " ", "eigenvalues", " ", "and", " ", "eigenfunctions"}],
    "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"L", "=", "100"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"dx", "=", ".05"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"total", "=", "50"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"H1", "=", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{
        RowBox[{"u", "''"}], "[", "x", "]"}]}], "+", 
      RowBox[{
       RowBox[{"Evaluate", "[", 
        RowBox[{"potentialhamiltonian", "[", "x", "]"}], "]"}], "*", 
       RowBox[{"u", "[", "x", "]"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"vals", ",", "fns"}], "}"}], "=", 
     RowBox[{"NDEigensystem", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"H1", ",", 
         RowBox[{"DirichletCondition", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"u", "[", "x", "]"}], "==", "0"}], ",", "True"}], "]"}]}],
         "}"}], ",", 
       RowBox[{"u", "[", "x", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{
          RowBox[{"-", "L"}], "/", "2"}], ",", 
         RowBox[{"L", "/", "2"}]}], "}"}], ",", "total", ",", 
       RowBox[{"Method", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\"\<PDEDiscretization\>\"", "->", 
           RowBox[{"{", 
            RowBox[{"\"\<FiniteElement\>\"", ",", 
             RowBox[{"\"\<MeshOptions\>\"", "->", 
              RowBox[{"{", 
               RowBox[{"\"\<MaxCellMeasure\>\"", "->", "dx"}], "}"}]}]}], 
            "}"}]}], ",", "\"\<Arnoldi\>\"", ",", 
          RowBox[{"\"\<MaxIterations\>\"", "->", "7000"}], ",", 
          RowBox[{"\"\<BasisSize\>\"", "->", 
           RowBox[{"total", "+", "1"}]}], ",", 
          RowBox[{"\"\<Shift\>\"", "->", "2.63"}]}], "}"}]}]}], "]"}]}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{3.989490168326009*^9, 3.989490188358281*^9}},
 CellLabel->"In[36]:=",ExpressionUUID->"4fd5cff4-35bc-48fb-a5b6-cf0ad2c5030b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Calculating", " ", "energy", " ", "shift"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Lambda]4", "=", 
     RowBox[{"4", "*", "Pi", "*", 
      RowBox[{"Pi", "/", "3"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Omega]b", "=", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"vals", "[", 
       RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   
   RowBox[{
    RowBox[{"Vbbbb", "=", 
     RowBox[{"NIntegrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"cosTerm", "[", "x", "]"}], "*", 
        RowBox[{
         RowBox[{"fns", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "^", "4"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{
          RowBox[{"-", "L"}], "/", "2"}], ",", 
         RowBox[{"L", "/", "2"}]}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"nshift", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"3", "*", "\[Kappa]", "*", 
        RowBox[{"\[Lambda]4", "/", 
         RowBox[{"(", 
          RowBox[{"4", "*", 
           RowBox[{"\[Omega]b", "^", "2"}]}], ")"}]}]}], ")"}], "*", 
      "Vbbbb"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Equad", "[", "n_", "]"}], ":=", 
     RowBox[{"n", "*", "\[Omega]b"}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"free", " ", "energy", " ", "levels"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Eshift", "[", "n_", "]"}], ":=", 
     RowBox[{
      RowBox[{"n", "*", "\[Omega]b"}], "-", 
      RowBox[{
       RowBox[{"n", "^", "2"}], "*", "nshift"}]}]}], ";"}], 
   RowBox[{"(*", 
    RowBox[{
    "energy", " ", "levels", " ", "with", " ", "first", " ", "order", " ", 
     "shift"}], "*)"}], "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.989490231828665*^9, 3.989490235515205*^9}, {
  3.98949028893858*^9, 3.989490336407878*^9}},
 CellLabel->"In[41]:=",ExpressionUUID->"c26caed9-eaec-4189-b07f-e65a05859447"],

