Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "Eigensystem", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"L", "=", "100"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"dx", "=", ".05"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"total", "=", "50"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"H1", "=", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{
        RowBox[{"u", "''"}], "[", "x", "]"}]}], "+", 
      RowBox[{
       RowBox[{"Evaluate", "[", 
        RowBox[{"potentialhamiltonian", "[", "x", "]"}], "]"}], "*", 
       RowBox[{"u", "[", "x", "]"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"vals", ",", "fns"}], "}"}], "=", 
     RowBox[{"NDEigensystem", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"H1", ",", 
         RowBox[{"DirichletCondition", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"u", "[", "x", "]"}], "==", "0"}], ",", "True"}], "]"}]}],
         "}"}], ",", 
       RowBox[{"u", "[", "x", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{
          RowBox[{"-", "L"}], "/", "2"}], ",", 
         RowBox[{"L", "/", "2"}]}], "}"}], ",", "total", ",", 
       RowBox[{"Method", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\"\<PDEDiscretization\>\"", "->", 
           RowBox[{"{", 
            RowBox[{"\"\<FiniteElement\>\"", ",", 
             RowBox[{"\"\<MeshOptions\>\"", "->", 
              RowBox[{"{", 
               RowBox[{"\"\<MaxCellMeasure\>\"", "->", "dx"}], "}"}]}]}], 
            "}"}]}], ",", "\"\<Arnoldi\>\"", ",", 
          RowBox[{"\"\<MaxIterations\>\"", "->", "7000"}], ",", 
          RowBox[{"\"\<BasisSize\>\"", "->", 
           RowBox[{"total", "+", "1"}]}], ",", 
          RowBox[{"\"\<Shift\>\"", "->", "2.63"}]}], "}"}]}]}], "]"}]}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{3.9894909689887733`*^9, 3.989490984657055*^9}},
 CellLabel->"In[11]:=",ExpressionUUID->"07d63d61-dfb8-4ee3-96bc-4d84bbb640f4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Calculating", " ", "energy", " ", "shift"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Lambda]4", "=", 
     RowBox[{"4", "*", "Pi", "*", 
      RowBox[{"Pi", "/", "3"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Omega]b", "=", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"vals", "[", 
       RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   
   RowBox[{
    RowBox[{"Vbbbb", "=", 
     RowBox[{"NIntegrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"cosTerm", "[", "x", "]"}], "*", 
        RowBox[{
         RowBox[{"fns", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "^", "4"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{
          RowBox[{"-", "L"}], "/", "2"}], ",", 
         RowBox[{"L", "/", "2"}]}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"nshift", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"3", "*", "\[Kappa]", "*", 
        RowBox[{"\[Lambda]4", "/", 
         RowBox[{"(", 
          RowBox[{"4", "*", 
           RowBox[{"\[Omega]b", "^", "2"}]}], ")"}]}]}], ")"}], "*", 
      "Vbbbb"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Equad", "[", "n_", "]"}], ":=", 
     RowBox[{"n", "*", "\[Omega]b"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Eshift", "[", "n_", "]"}], ":=", 
     RowBox[{
      RowBox[{"n", "*", "\[Omega]b"}], "-", 
      RowBox[{
       RowBox[{"n", "^", "2"}], "*", "nshift"}]}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.9894911200189533`*^9, 3.9894911644144897`*^9}},
 CellLabel->"In[16]:=",ExpressionUUID->"27b9127a-98ff-46df-828a-7390536220e2"],

Cell[BoxData[
 TemplateBox[{
  "NIntegrate", "ncvb", 
   "\"NIntegrate failed to converge to prescribed accuracy after \
\\!\\(\\*RowBox[{\\\"9\\\"}]\\) recursive bisections in \
\\!\\(\\*RowBox[{\\\"x\\\"}]\\) near \\!\\(\\*RowBox[{\\\"{\\\", \\\"x\\\", \
\\\"}\\\"}]\\) = \\!\\(\\*RowBox[{\\\"{\\\", \\\"0.19375833594676195`\\\", \\\
\"}\\\"}]\\). NIntegrate obtained \\!\\(\\*RowBox[{\\\"-\\\", \
\\\"0.1272665888085966`\\\"}]\\) and \
\\!\\(\\*RowBox[{\\\"7.511615418015912`*^-7\\\"}]\\) for the integral and \
error estimates.\"", 2, 18, 5, 20665763920056953601, "Local"},
  "MessageTemplate"]], "Message", "MSG",
 CellChangeTimes->{3.989491262999146*^9},
