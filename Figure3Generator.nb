Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{
     "import", " ", "steady", " ", "state", " ", "for", " ", "\[Kappa]"}], 
     "=", "0.3"}], ",", 
    RowBox[{"g", "=", "1.5"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Kappa]", "=", "0.3"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"g", "=", "1.5"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Get", "[", 
     "\"\</Users/zoe/Documents/Wolfram Mathematica/fig1_phiss_g1p5_k0p3\>\"", 
     "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Phi0p3", "=", 
     RowBox[{"Interpolation", "[", 
      RowBox[{"FinalPhiList", ",", 
       RowBox[{"InterpolationOrder", "->", "4"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Phi]ss0p3", "[", "x_", "]"}], ":=", 
     RowBox[{"Phi0p3", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"\[Pi]", "^", 
          RowBox[{"(", 
           RowBox[{"1", "/", "2"}], ")"}]}], "*", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"2", "  ", "\[Pi]", "*", "\[Kappa]"}], ")"}], "^", 
            RowBox[{"(", 
             RowBox[{"1", "/", "2"}], ")"}]}], "  ", "x"}], "]"}]}], ")"}], 
       "/", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"2", "  ", "\[Pi]", "*", "\[Kappa]"}], ")"}], "^", 
            RowBox[{"(", 
             RowBox[{"1", "/", "2"}], ")"}]}], "  ", "x"}], "]"}]}], ")"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"data", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"\[Phi]ss0p3", "[", "x", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"-", "50"}], ",", "50", ",", "0.001"}], "}"}]}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"\[Phi]ssint", "=", 
     RowBox[{"Interpolation", "[", "data", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"intermediatePhi", "[", "x_", "]"}], ":=", 
     RowBox[{"2", "*", 
      RowBox[{"Sqrt", "[", "\[Pi]", "]"}], "*", 
      RowBox[{"\[Phi]ssint", "[", "x", "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"cosTerm", "[", "x_", "]"}], ":=", 
     RowBox[{"Cos", "[", 
      RowBox[{"intermediatePhi", "[", "x", "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"potentialhamiltonian", "[", "x_", "]"}], ":=", 
     RowBox[{
      RowBox[{"2", "*", "Pi", "*", "\[Kappa]", "*", 
       RowBox[{"cosTerm", "[", "x", "]"}]}], "+", 
      RowBox[{"g", "^", "2"}]}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.989490872320191*^9, 3.9894909196768427`*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"bed8c3c5-259d-4402-8ed4-200f3db25eb6"],

