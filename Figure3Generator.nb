Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Lambda]4", "=", 
   RowBox[{"4", "*", "Pi", "*", 
    RowBox[{"Pi", "/", "3"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Omega]b", "=", 
   RowBox[{"Sqrt", "[", 
    RowBox[{"vals", "[", 
     RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Vbbbb", "=", 
   RowBox[{"NIntegrate", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"cosTerm", "[", "x", "]"}], "*", 
      RowBox[{
       RowBox[{"fns", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "^", "4"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{
        RowBox[{"-", "L"}], "/", "2"}], ",", 
       RowBox[{"L", "/", "2"}]}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nshift", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"3", "*", "\[Kappa]", "*", 
      RowBox[{"\[Lambda]4", "/", 
       RowBox[{"(", 
        RowBox[{"4", "*", 
         RowBox[{"\[Omega]b", "^", "2"}]}], ")"}]}]}], ")"}], "*", 
    "Vbbbb"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Equad", "[", "n_", "]"}], ":=", 
   RowBox[{"n", "*", "\[Omega]b"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Eshift", "[", "n_", "]"}], ":=", 
   RowBox[{
    RowBox[{"n", "*", "\[Omega]b"}], "-", 
    RowBox[{
     RowBox[{"n", "^", "2"}], "*", "nshift"}]}]}], ";"}]}], "Input",
