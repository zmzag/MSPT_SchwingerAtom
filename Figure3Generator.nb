Cell[BoxData[{
 RowBox[{
  RowBox[{"L", "=", "100"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dx", "=", ".05"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"total", "=", "50"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"H1", "=", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{
      RowBox[{"u", "''"}], "[", "x", "]"}]}], "+", 
    RowBox[{
     RowBox[{"Evaluate", "[", 
      RowBox[{"potentialhamiltonian", "[", "x", "]"}], "]"}], "*", 
     RowBox[{"u", "[", "x", "]"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"vals", ",", "fns"}], "}"}], "=", 
   RowBox[{"NDEigensystem", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"H1", ",", 
       RowBox[{"DirichletCondition", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"u", "[", "x", "]"}], "==", "0"}], ",", "True"}], "]"}]}], 
      "}"}], ",", 
     RowBox[{"u", "[", "x", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{
        RowBox[{"-", "L"}], "/", "2"}], ",", 
       RowBox[{"L", "/", "2"}]}], "}"}], ",", "total", ",", 
     RowBox[{"Method", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\"\<PDEDiscretization\>\"", "->", 
         RowBox[{"{", 
          RowBox[{"\"\<FiniteElement\>\"", ",", 
           RowBox[{"\"\<MeshOptions\>\"", "->", 
            RowBox[{"{", 
             RowBox[{"\"\<MaxCellMeasure\>\"", "->", "dx"}], "}"}]}]}], 
          "}"}]}], ",", "\"\<Arnoldi\>\"", ",", 
        RowBox[{"\"\<MaxIterations\>\"", "->", "7000"}], ",", 
        RowBox[{"\"\<BasisSize\>\"", "->", 
         RowBox[{"total", "+", "1"}]}], ",", 
        RowBox[{"\"\<Shift\>\"", "->", "2.63"}]}], "}"}]}]}], "]"}]}], 
  ";"}]}], "Input",
