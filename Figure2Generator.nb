Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Finding", " ", "eigenvalues", " ", "and", " ", "eigenfunctions", " ", 
    "of", " ", "quadratic", " ", "theory"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"L", "=", "100"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"dx", "=", ".05"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"total", "=", "50"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"H1", "=", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{
        RowBox[{"u", "''"}], "[", "x", "]"}]}], "+", 
      RowBox[{
       RowBox[{"Evaluate", "[", 
        RowBox[{"potentialhamiltonian", "[", "x", "]"}], "]"}], "*", 
       RowBox[{"u", "[", "x", "]"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"vals", ",", "fns"}], "}"}], "=", 
     RowBox[{"NDEigensystem", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"H1", ",", 
         RowBox[{"DirichletCondition", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"u", "[", "x", "]"}], "==", "0"}], ",", "True"}], "]"}]}],
         "}"}], ",", 
       RowBox[{"u", "[", "x", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{
          RowBox[{"-", "L"}], "/", "2"}], ",", 
         RowBox[{"L", "/", "2"}]}], "}"}], ",", "total", ",", 
       RowBox[{"Method", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\"\<PDEDiscretization\>\"", "->", 
           RowBox[{"{", 
            RowBox[{"\"\<FiniteElement\>\"", ",", 
             RowBox[{"\"\<MeshOptions\>\"", "->", 
              RowBox[{"{", 
               RowBox[{"\"\<MaxCellMeasure\>\"", "->", "dx"}], "}"}]}]}], 
            "}"}]}], ",", "\"\<Arnoldi\>\"", ",", 
          RowBox[{"\"\<MaxIterations\>\"", "->", "7000"}], ",", 
          RowBox[{"\"\<BasisSize\>\"", "->", 
           RowBox[{"total", "+", "1"}]}], ",", 
          RowBox[{"\"\<Shift\>\"", "->", "2.8"}]}], "}"}]}]}], "]"}]}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{3.98948876762959*^9, 3.989488801338231*^9}, {
  3.989488932504554*^9, 3.989488933338245*^9}},
 CellLabel->"In[60]:=",ExpressionUUID->"d9743035-3259-49c8-8fb7-4386db2baab6"],

