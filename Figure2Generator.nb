Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"The", " ", "bound", " ", 
     RowBox[{"eigenfunction", "'"}], "s", " ", "y", " ", "value", " ", 
     "corresponds", " ", "to", " ", "its", " ", "eigenvalue", " ", "so", " ", 
     "it", " ", "looks", " ", "more", " ", "accurate", " ", "next", " ", "to",
      " ", "the", " ", "potential", " ", "well"}], ",", " ", 
    RowBox[{"but", " ", "the", " ", "scattering", " ", 
     RowBox[{"state", "'"}], "s", " ", "y", " ", "value", " ", "is", " ", 
     "just", " ", "chosen", " ", "so", " ", "its", " ", "above", " ", "the", 
     " ", "potential", " ", "but", " ", "they", " ", "dont", " ", "overlap", 
     " ", "so", " ", "you", " ", "can", " ", "see", " ", "them", " ", 
     RowBox[{"clearly", ".", "  ", "minus"}], " ", "signs", " ", "are", " ", 
     "added", " ", "to", " ", "give", " ", "the", " ", "same", " ", "sign", 
     " ", "convention", " ", "to", " ", "each", " ", "eigenfunction"}]}], 
   "*)"}], "\[IndentingNewLine]", 
