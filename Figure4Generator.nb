    RowBox[{"vals", "[", 
     RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"k2b", "=", 
   RowBox[{"Sqrt", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"2", "*", "\[Omega]b"}], ")"}], "^", "2"}], "-", 
     RowBox[{"g", "^", "2"}], "-", 
     RowBox[{"2", "*", "Pi", "*", "\[Kappa]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"fk", "[", "x_", "]"}], ":=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"fns", "[", 
        RowBox[{"[", 
         RowBox[{"k", "+", "1"}], "]"}], "]"}], "+", 
       RowBox[{"I", "*", 
        RowBox[{"fns", "[", 
         RowBox[{"[", "k", "]"}], "]"}]}]}], ")"}], "/", 
     RowBox[{"Sqrt", "[", "2", "]"}]}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"Switch", " ", "from", " ", 
    RowBox[{"even", "/", "odd"}], " ", "to", " ", 
    RowBox[{"right", "/", "left"}], " ", "moving"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"Vbbk", "=", 
   RowBox[{"NIntegrate", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Sin", "[", 
       RowBox[{"intermediatePhi", "[", "x", "]"}], "]"}], "*", 
      RowBox[{"fns", "[", 
       RowBox[{"[", "1", "]"}], "]"}], "*", 
      RowBox[{"fns", "[", 
       RowBox[{"[", "1", "]"}], "]"}], "*", 
      RowBox[{"fk", "[", "x", "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{
        RowBox[{"-", "L"}], "/", "2"}], ",", 
       RowBox[{"L", "/", "2"}]}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Bparam", "=", 
   RowBox[{
    RowBox[{"\[Lambda]3", "^", "2"}], "*", 
    RowBox[{
     RowBox[{
      RowBox[{"Abs", "[", "Vbbk", "]"}], "^", "2"}], "/", 
     RowBox[{"(", 
      RowBox[{"4", "*", 
       RowBox[{"\[Omega]b", "^", "3"}]}], ")"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Cparam", "=", 
   RowBox[{"3", "*", "I", "*", "\[Lambda]4", "*", 
    RowBox[{"Vbbbb", "/", 
     RowBox[{"(", 
      RowBox[{"4", "*", 
       RowBox[{"\[Omega]b", "^", "2"}]}], ")"}]}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"tMax", "=", "100"}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{
   "what", " ", "time", " ", "\[Tau]", " ", "to", " ", "evolve", " ", "to"}], 
   "*)"}], "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"nb", "[", "t", "]"}], "=", 
     RowBox[{"<", "n_b", ">"}]}], ",", 
    RowBox[{
     RowBox[{"s", "[", "t", "]"}], "=", 
     RowBox[{"<", 
      RowBox[{
       RowBox[{
        RowBox[{"\[CapitalSigma]", "^"}], "\\", "dagger"}], " ", "a_b", " ", 
       "a_b"}], ">"}]}], ",", 
    RowBox[{
     RowBox[{"q", "[", "t", "]"}], "=", 
     RowBox[{"<", 
      RowBox[{
       RowBox[{
        RowBox[{"a_b", "^"}], "\\", "dagger"}], " ", "n_b", " ", "a_b"}], 
      ">"}]}], ",", 
    RowBox[{
     RowBox[{"p", "[", "t", "]"}], "=", 
     RowBox[{"<", 
      RowBox[{
       RowBox[{
        RowBox[{"\[CapitalSigma]", "^"}], "\\", "dagger"}], " ", 
       "\[CapitalSigma]"}], ">"}]}], ",", " ", 
    RowBox[{
    "IC", " ", "is", " ", "2", " ", "excitations", " ", "in", " ", "bound", 
     " ", "state"}], ",", " ", 
    RowBox[{
    "0", " ", "excitations", " ", "in", " ", "any", " ", "of", " ", "the", 
     " ", "scattering", " ", "states"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"sol1", "=", 
    RowBox[{"NDSolve", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"nb", "'"}], "[", "t", "]"}], "==", 
         RowBox[{
          RowBox[{"-", "2"}], "*", "Bparam", "*", 
          RowBox[{"Re", "[", 
           RowBox[{"s", "[", "t", "]"}], "]"}]}]}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"s", "'"}], "[", "t", "]"}], "==", 
         RowBox[{
          RowBox[{"q", "[", "t", "]"}], "-", 
          RowBox[{"Bparam", "*", 
           RowBox[{"p", "[", "t", "]"}]}], "+", 
          RowBox[{"Cparam", "*", 
           RowBox[{"s", "[", "t", "]"}]}]}]}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"q", "'"}], "[", "t", "]"}], "==", 
         RowBox[{
          RowBox[{"-", "2"}], "*", "Bparam", "*", 
          RowBox[{"Re", "[", 
           RowBox[{"s", "[", "t", "]"}], "]"}]}]}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"p", "'"}], "[", "t", "]"}], "==", 
         RowBox[{"2", "*", 
          RowBox[{"Re", "[", 
           RowBox[{"s", "[", "t", "]"}], "]"}]}]}], ",", 
        RowBox[{
         RowBox[{"nb", "[", "0", "]"}], "==", "2"}], ",", 
        RowBox[{
         RowBox[{"s", "[", "0", "]"}], "==", 
         RowBox[{"0", "+", 
          RowBox[{"0", "*", "I"}]}]}], ",", 
        RowBox[{
         RowBox[{"q", "[", "0", "]"}], "==", "2"}], ",", 
        RowBox[{
         RowBox[{"p", "[", "0", "]"}], "==", "0"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"nb", ",", "s", ",", "q", ",", "p"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "0", ",", "tMax"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "plot", " ", "expectation", " ", "value", " ", "of", " ", "number", " ", 
    "of", " ", "occupations", " ", "in", " ", "bound", " ", "state"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"nb", "[", "t", "]"}], "/.", " ", "sol1"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "tMax"}], "}"}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Style", "[", 
       RowBox[{"\"\<\[Tau]\>\"", ",", "14"}], "]"}], ",", 
      RowBox[{"Style", "[", 
       RowBox[{"\"\<<n_b>\>\"", ",", "14"}], "]"}]}], "}"}]}], ",", 
   RowBox[{"PlotStyle", "->", 
    RowBox[{"Directive", "[", 
     RowBox[{
      RowBox[{"Darker", "@", "Green"}], ",", "Thick"}], "]"}]}]}], 
  "]"}]}], "Input",
 CellChangeTimes->{
  3.989492723194742*^9, {3.989492758979682*^9, 3.989492783043647*^9}, {
   3.98949285050078*^9, 3.989492991384691*^9}, {3.98949307594765*^9, 
