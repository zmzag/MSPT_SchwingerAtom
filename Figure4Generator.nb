Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Import", " ", "\[Kappa]"}], "=", 
    RowBox[{"0.2", " ", "and", " ", "find", " ", "eigen"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Kappa]", "=", "0.2"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"g", "=", "1.5"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Get", "[", 
     "\"\</Users/zoe/Documents/Wolfram Mathematica/fig1_phiss_g1p5_k0p2\>\"", 
     "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Phi0p2", "=", 
     RowBox[{"Interpolation", "[", 
      RowBox[{"FinalPhiList", ",", 
       RowBox[{"InterpolationOrder", "->", "4"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Phi]ss0p2", "[", "x_", "]"}], ":=", 
     RowBox[{"Phi0p2", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"\[Pi]", "^", 
          RowBox[{"(", 
           RowBox[{"1", "/", "2"}], ")"}]}], "*", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"2", "  ", "\[Pi]", "*", "\[Kappa]"}], ")"}], "^", 
            RowBox[{"(", 
             RowBox[{"1", "/", "2"}], ")"}]}], "  ", "x"}], "]"}]}], ")"}], 
       "/", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"2", "  ", "\[Pi]", "*", "\[Kappa]"}], ")"}], "^", 
            RowBox[{"(", 
             RowBox[{"1", "/", "2"}], ")"}]}], "  ", "x"}], "]"}]}], ")"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"data", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"\[Phi]ss0p2", "[", "x", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"-", "50"}], ",", "50", ",", "0.001"}], "}"}]}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"\[Phi]ssint", "=", 
     RowBox[{"Interpolation", "[", "data", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"intermediatePhi", "[", "x_", "]"}], ":=", 
     RowBox[{"2", "*", 
      RowBox[{"Sqrt", "[", "\[Pi]", "]"}], "*", 
      RowBox[{"\[Phi]ssint", "[", "x", "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"cosTerm", "[", "x_", "]"}], ":=", 
     RowBox[{"Cos", "[", 
      RowBox[{"intermediatePhi", "[", "x", "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"potentialhamiltonian", "[", "x_", "]"}], ":=", 
     RowBox[{
      RowBox[{"2", "*", "Pi", "*", "\[Kappa]", "*", 
       RowBox[{"cosTerm", "[", "x", "]"}]}], "+", 
      RowBox[{"g", "^", "2"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"L", "=", "100"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"dx", "=", ".05"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"total", "=", "90"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"H1", "=", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{
        RowBox[{"u", "''"}], "[", "x", "]"}]}], "+", 
      RowBox[{
       RowBox[{"Evaluate", "[", 
        RowBox[{"potentialhamiltonian", "[", "x", "]"}], "]"}], "*", 
       RowBox[{"u", "[", "x", "]"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"vals", ",", "fns"}], "}"}], "=", 
     RowBox[{"NDEigensystem", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"H1", ",", 
         RowBox[{"DirichletCondition", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"u", "[", "x", "]"}], "==", "0"}], ",", "True"}], "]"}]}],
         "}"}], ",", 
       RowBox[{"u", "[", "x", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{
          RowBox[{"-", "L"}], "/", "2"}], ",", 
         RowBox[{"L", "/", "2"}]}], "}"}], ",", "total", ",", 
       RowBox[{"Method", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\"\<PDEDiscretization\>\"", "->", 
           RowBox[{"{", 
            RowBox[{"\"\<FiniteElement\>\"", ",", 
             RowBox[{"\"\<MeshOptions\>\"", "->", 
              RowBox[{"{", 
               RowBox[{"\"\<MaxCellMeasure\>\"", "->", "dx"}], "}"}]}]}], 
            "}"}]}], ",", "\"\<Arnoldi\>\"", ",", 
          RowBox[{"\"\<MaxIterations\>\"", "->", "7000"}], ",", 
          RowBox[{"\"\<BasisSize\>\"", "->", 
           RowBox[{"total", "+", "1"}]}], ",", 
          RowBox[{"\"\<Shift\>\"", "->", "2.8"}]}], "}"}]}]}], "]"}]}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{3.9894933275488043`*^9, 3.989493342286792*^9}, {
  3.989493391088159*^9, 3.989493444245647*^9}, {3.9894936424853687`*^9, 
